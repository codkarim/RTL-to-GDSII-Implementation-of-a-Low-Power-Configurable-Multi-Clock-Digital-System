  test_cell() {
    pin(SI) {
      direction : input;
      signal_type : test_scan_in;
    }
    pin(SE) {
      direction : input;
      signal_type : test_scan_enable;
    }
    pin(D) {
      direction : input;
    }
    pin(CK) {
      direction : input;
    }
    pin(E) {
      direction : input;
    }
    ff(IQ,IQN) {
      clocked_on : "CK";
      next_state : "(D E) + (!E IQ)";
    }
    pin(Q) {
      direction : output;
      function : "IQ";
      signal_type : test_scan_out;
    }
    pin(QN) {
      direction : output;
      function : "IQN";
      signal_type : test_scan_out_inverted;
    }
  }
